{
  "name": "ryans-morse-code-trainer",
  "private": true,
  "version": "0.1.0",
  "description": "Ditdah \u2014 learn to send and receive Morse code with picture/sound mnemonics, a QSO simulator, and a translator. A React remake inspired by Ace Centre's Morse Learn.",
  "license": "Apache-2.0",
  "author": "Ryan Byrd",
  "homepage": "https://ryans-morse-code-trainer.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/theryanbyrd/ryans-morse-code-trainer"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:ios": "VITE_SUPABASE_URL= VITE_SUPABASE_ANON_KEY= VITE_SUPABASE_PUBLISHABLE_KEY= npm run build && node scripts/verify-ios-bundle.mjs && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.110.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "webgazer": "^3.5.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "axe-core": "^4.12.1",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
