{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.ditdah.me" }],
      "destination": "https://ditdah.me/$1",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/keepalive",
      "schedule": "0 7 * * *"
    }
  ]
}
